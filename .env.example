# Local Development & Testing Environment Variables
# Copy to .env for local script execution if needed.
# Note: In AWS Lambda, these are populated automatically by template.yaml.

# AWS Region & Mock Config
AWS_DEFAULT_REGION=us-east-1

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=AnomalyDetectionRecords
INDEX_NAME=TypeCreatedAtIndex

# SNS Alerting
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:serverless-anomaly-detection-anomaly-alerts
ALERT_THRESHOLD=1

# Storage & Ingestion Filters
ALLOWED_PREFIX=incoming/
MAX_FILE_SIZE_BYTES=10485760

# Model Configuration
MODEL_PATH=src/processor/models/isolation_forest_model.joblib
MODEL_CONTAMINATION=0.05

# Logging
LOG_LEVEL=INFO
